(executable
 (name main)
 ; Installed as <prefix>/bin/sun-notes, which is what makes
 ; `opam install https://github.com/korkorran/Sun-notes` produce a command the
 ; user can run. The page and the icon go to <prefix>/share/sun-notes, see the
 ; install stanza at the bottom of this file.
 (public_name sun-notes)
 ; lwt.unix brings Lwt together with Lwt_unix, Lwt_io and Lwt_preemptive;
 ; threads.posix is what lets the Lwt event loop have a thread of its own,
 ; since the webview keeps the process's main thread.
 ;
 ; owebview.desktop is the companion library for what a native application
 ; needs beyond the web view itself; Locate_assets is what tells the binary
 ; where its web/ directory is.
 ; yojson encodes the binding replies and decodes their requests: the
 ; bridge is a text protocol in both directions, and OCaml's own Printf and
 ; Scanf speak OCaml literal syntax, not JSON's.
 (libraries owebview owebview.desktop unix lwt.unix threads.posix yojson)
 (link_flags
  (:include link_flags.sexp)))

; On Windows an executable declares in its PE header whether it is a console
; (CUI) or a graphical (GUI) program, and ocamlopt produces the former. Windows
; then allocates a console window whenever the app is launched from Explorer,
; whether or not anything is written to it — which is what users saw.
;
; Two rules with complementary conditions rather than one: dune has no OS
; conditional for link_flags, but it does have enabled_if on rules, and
; %{system} is one of the variables allowed there. mingw64 is what it reads as
; on the Windows toolchain owebview supports.
;
; The flag is flexlink's, not gcc's, and that took two wrong guesses to learn.
; On Windows OCaml links through flexlink, which has its own option list — and
; its own default:
;
;   -subsystem <id>     Set the subsystem (default: console)
;
; That default is the whole of the original symptom. Two spellings that look
; right and are not: -Wl,--subsystem,windows, which flexlink forwards verbatim
; to gcc, where --subsystem is not an option it knows; and -mwindows, gcc's own
; flag for this, which never reaches gcc because flexlink rejects it first.
;
; Each -ccopt carries one argument, so it takes two of them to say
; "-subsystem windows".
;
; The consequence worth knowing: a GUI program has no standard output when it
; is started from Explorer. The tracing in binding.ml is behind
; SUN_NOTES_DEBUG for that reason among others. Output still arrives normally
; when the process is started from a shell with its handles redirected, which
; is how the CI smoke tests read it.
; The dune profile the binary was built with, as a value main.ml can read:
; the web inspector is on in every profile but release. `dune build -p`, which
; is what opam runs, implies the release profile, and so does --release in the
; packaging scripts, so neither ships with the inspector enabled.
(rule
 (target build_profile.ml)
 (action
  (write-file %{target} "let profile = \"%{profile}\"\n")))

(rule
 (target link_flags.sexp)
 (enabled_if
  (= %{system} mingw64))
 (action
  (write-file link_flags.sexp "(-ccopt -subsystem -ccopt windows)")))

(rule
 (target link_flags.sexp)
 (enabled_if
  (<> %{system} mingw64))
 (action
  (write-file link_flags.sexp "()")))

; The page and the icon are files on disk, and they reach the running binary by
; two different routes. main.ml reads either one (see data_path there); what
; follows is the two routes.
;
; In a build tree they are staged beside the binary, in _build/default/run/, so
; that `dune exec run/main.exe` is self-contained and the packaging scripts have
; one directory to copy from. The alias is what builds them: `dune build` does
; not run a rule nothing depends on.
(alias
 (name all)
 (deps
  (glob_files web/*)
  logo.png))

(rule
 (target logo.png)
 (deps ../logo.png)
 (action
  (copy ../logo.png logo.png)))

; Installed by opam they go to <prefix>/share/sun-notes, beside the
; <prefix>/bin/sun-notes the public_name above installs. This is the only route
; `opam install` takes: the opam build command is `dune build -p sun-notes
; @install`, which builds what is installed and nothing else — the alias above
; is not part of it.
;
; Only the three files the page actually loads. The rest of run/web/ is build
; input: app.ml and its modules are what app.js is compiled from, and app.bc.js
; is the intermediate the rule in run/web/dune renames.
(install
 (package sun-notes)
 (section share)
 (files
  (web/index.html as web/index.html)
  (web/style.css as web/style.css)
  (web/app.js as web/app.js)
  (logo.png as logo.png)))

; The .deb, .rpm, .dmg and Windows packages use neither route: their scripts
; copy main.exe and web/ out of the build tree by name, and build their own
; icons from the logo.png at the repository root. The staged logo.png above
; therefore never reaches one of those packages — which is what lets main.ml
; read "no installer icon around me" as the sign of a build tree or an opam
; install.
